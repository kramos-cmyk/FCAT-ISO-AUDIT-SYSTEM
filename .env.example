# APP_URL: Public URL of the deployed application (injected in AI Studio or Render)
APP_URL="http://localhost:3000"

# PORT: Server port (3000 in AI Studio, Render sets PORT automatically)
PORT=3000

# JWT_SECRET: Secret key for signing authentication session tokens (set a strong random string on Render)
JWT_SECRET="change-me-to-a-long-random-secret"

# DB_PATH: File path for the SQLite database (e.g. /var/data/fcat_audit.db on a Render Persistent Disk)
DB_PATH="./data/fcat_audit.db"

# UPLOAD_DIR: Directory for uploaded evidence files and announcement images (e.g. /var/data/uploads on Render)
UPLOAD_DIR="./data/uploads"

# OPTIONAL - CONNECT TO EXISTING GOOGLE SHEET (Service Account)
# Share your existing Google Sheet with the Service Account client_email as Editor.
# When both GOOGLE_SPREADSHEET_ID and GOOGLE_SERVICE_ACCOUNT_JSON are set, the app uses your Google Sheet directly.
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_MAIN_FOLDER_ID=""
GOOGLE_DRIVE_EVIDENCE_FOLDER_ID=""
GOOGLE_DRIVE_ANNOUNCEMENT_FOLDER_ID=""

# OPTIONAL - AUTO EMAIL NOTIFICATIONS
# Option A: HTTPS Email Relay (recommended on Render Free Tier where SMTP ports 465/587 are blocked)
GOOGLE_MAIL_WEBHOOK_URL=""
GOOGLE_MAIL_WEBHOOK_SECRET=""
BREVO_API_KEY=""
RESEND_API_KEY=""

# Option B: Direct SMTP (Google Workspace / Gmail App Password on paid hosts or VPS)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
